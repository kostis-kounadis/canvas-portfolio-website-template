{
  "site": {
    "title": "My Portfolio",
    "email": "hello@example.com",
    "url": "https://example.com",
    "infoText": "Your name — a short description of what you do and what this portfolio contains. Supports **bold**, _italic_, and [links](https://example.com).\n\nFor commissions and collaborations, feel free to reach out.",
    "author": "Your Name"
  },
  "seo": {
    "metaDescription": "Portfolio of projects, experiments and media.",
    "keywords": ["portfolio", "design"],
    "ogImage": "og-image.jpg",
    "twitterHandle": "@handle",
    "canonicalUrl": "https://example.com/",
    "schemaType": "Person",
    "jobTitle": "Designer",
    "sameAs": []
  },
  "ui": {
    "modules": {
      "title":      { "visible": true,  "position": "top-left",    "mode": "text", "text": "My Portfolio", "logoFile": "" },
      "email":      { "visible": true,  "position": "top-right" },
      "info":       { "visible": true,  "position": "top-right" },
      "categories": { "visible": true,  "position": "middle-left" },
      "layouts":    { "visible": true,  "position": "middle-right" }
    },
    "zoom":         { "visible": true },
    "textSize":     "18px",
    "fontEmbedCode": ""
  },
  "theme": {
    "backgroundColor": "#f7f5f0",
    "textColor": "#ffff00",
    "blendMode": true,
    "textAnimation": "none",
    "backgroundEffect": "solid",
    "backgroundGradientFrom": "#f7f5f0",
    "backgroundGradientTo": "#e0e0e0",
    "noiseGrain": { "enabled": false, "opacity": 0.04 },
    "imageShadow": { "enabled": true, "opacity": 0.06, "blur": 30, "color": "#000000" }
  },
  "layouts": {
    "available": ["random", "rows", "stacks"],
    "default": "random",
    "labels": ["▩▩▩", "▤▤▤", "▧▧▧"],
    "random":  { "scarcity": 520, "overlapRatio": 0.2, "draggable": true },
    "rows":    { "rowHeight": 280, "gap": 24 },
    "stacks":  { "spacing": 1000 }
  },
  "categories": {
    "behaviour": "hide-on-click",
    "focusEffect": "hide",
    "viewAllLabel": "ALL"
  },
  "imageEffects": {
    "initialState": "colour",
    "hoverReveal": false,
    "clickMode": "none",
    "clickStickyMode": "multi",
    "blurOthersOnClick": false
  },
  "imageClick": {
    "lightbox": { "enabled": false, "backdropEffect": "darken" },
    "canvasExpand": { "enabled": false }
  },
  "info": {
    "overlayEffect": "none",
    "buttonStyle": "arrow",
    "closeStyle": "x-only"
  },
  "mobile": {
    "defaultMode": "canvas"
  }
}
